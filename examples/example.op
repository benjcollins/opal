module main;

fun main() {
    assert(sum(10) == 55);
    assert(fib(5) == 8);
    return;
}

fun sum(n: Int) -> Int {
    if (n == 0) {
        return 0;
    } else {
        return n + sum(n - 1);
    }
}

fun fib(n: Int) -> Int {
    if (n <= 1) {
        return 1;
    } else {
        return fib(n - 1) + fib(n - 2);
    }
}
